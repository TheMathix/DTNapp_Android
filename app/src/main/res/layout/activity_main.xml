<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Botão e lista de bundles -->
    <Button
        android:id="@+id/btnRefreshBundles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Bundles"
        android:layout_marginTop="24dp"/>

    <Button
        android:id="@+id/btnSendAudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send test audio"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnSendTinyBundle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send tiny bundle"
        android:layout_marginTop="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBundles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"/>

</LinearLayout>
